  <geom type="box" size=".3 .6 .02" pos="2 0.0 .015" material="block" euler="0  0.1 -0.1"/>
  <geom type="box" size=".3 .6 .02" pos="3 0.0 .025" material="block" euler="0 -0.1  0.0"/>  
  <geom type="box" size=".3 .6 .02" pos="4 0.0 .015" material="block" euler="0  0.1  0.1"/>
  <geom type="box" size=".3 .6 .02" pos="5 0.0 .015" material="block" euler="0 -0.1 -0.1"/>   -->
</worldbody>
</mujoco>
